+    /**
+     * Checks whether a TLV can exchange positions with an adjacent sibling.
+     *
+     * @param document current snapshot; may be null
+     * @param node selected TLV; may be null or stale
+     * @param direction sibling offset, either -1 (up) or 1 (down)
+     * @return true when both siblings are editable and share the same parent
+     */
+    public boolean canMove(Document document, Node node, int direction) {
+        if (document == null || (direction != -1 && direction != 1) || !canDelete(document, node)) {
+            return false;
+        }
+        Node parent = parentOf(document.root(), node);
+        int destination = parent.childTlvs().indexOf(node) + direction;
+        return destination >= 0 && destination < parent.childTlvs().size()
+                && canDelete(document, parent.childTlvs().get(destination));
+    }
+
+    /**
+     * Exchanges adjacent sibling statements, carrying complete subtrees together.
+     *
+     * <p>Recompiles through OSCAR and retains the source file and document origin.
+     * Inter-statement comments and whitespace remain in their original slots.
+     *
+     * @param document current document snapshot
+     * @param node owned TLV to move
+     * @param direction sibling offset, either -1 (up) or 1 (down)
+     * @return updated document with refreshed text and binary-backed tree
+     * @throws InspectionException if movement is disallowed or compilation fails
+     */
+    public Document move(Document document, Node node, int direction) throws InspectionException {
+        if (!canMove(document, node, direction)) {
+            throw new InspectionException("Move a TLV only within its parent and past editable siblings.");
+        }
+        Node parent = parentOf(document.root(), node);
+        Node neighbor = parent.childTlvs().get(parent.childTlvs().indexOf(node) + direction);
+        Node first = node.sourceStartOffset() < neighbor.sourceStartOffset() ? node : neighbor;
+        Node second = first == node ? neighbor : node;
+        String text = document.text();
+        String changedText = text.substring(0, first.sourceStartOffset())
+                + text.substring(second.sourceStartOffset(), second.sourceEndExclusive())
+                + text.substring(first.sourceEndExclusive(), second.sourceStartOffset())
+                + text.substring(first.sourceStartOffset(), first.sourceEndExclusive())
+                + text.substring(second.sourceEndExclusive());
+        return parse(document.path(), changedText, document.diskHash(), document.reference())
+                .withOrigin(document.origin());
+    }
+
