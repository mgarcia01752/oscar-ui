+    @Test void oscarMustPreserveRequestedChildOrder() throws Exception {
+        byte[] encoded = OscarTextCompileCheck.compile(
+                "Docsis { DownstreamServiceFlow { MaxSubstainedTrafficRate 1000; ServiceFlowReference 1; } }");
+        assertEquals(8, Byte.toUnsignedInt(encoded[2]),
+                "OSCAR must encode the first requested child (25.8) before 25.1");
+    }
