+    @Test void movesSubtreesAndChildrenOnlyWithinTheirParent() throws Exception {
+        String flow = "DownstreamServiceFlow { ServiceFlowReference 1; MaxSubstainedTrafficRate 1000000000; }";
+        String source = "\uFEFFDocsis {\r\n NetworkAccess 1; /* keep */ " + flow + "\r\n}";
+        var original = open(source);
+        var parent = original.root().childTlvs().get(1);
+        var moved = service.move(original, parent, -1);
+        assertEquals("\uFEFFDocsis {\r\n " + flow + " /* keep */ NetworkAccess 1;\r\n}", moved.text());
+        assertEquals("DownstreamServiceFlow", moved.root().childTlvs().getFirst().tlvName());
+        assertEquals(source, service.move(moved, moved.root().childTlvs().getFirst(), 1).text());
+        assertFalse(service.canMove(original, parent.childTlvs().getFirst(), -1));
+        assertFalse(service.canMove(original, parent.childTlvs().getLast(), 1));
+        var childMoved = service.move(original, parent.childTlvs().getLast(), -1);
+        assertEquals("MaxSubstainedTrafficRate", childMoved.root().childTlvs().get(1).childTlvs().getFirst().tlvName());
+        assertTrue(childMoved.text().contains("MaxSubstainedTrafficRate 1000000000; ServiceFlowReference 1;"));
+        assertFalse(service.canMove(childMoved, parent, -1));
+        assertFalse(service.canMove(original, original.root(), 1));
+        assertFalse(service.canMove(null, null, 1));
+        assertThrows(InspectionException.class, () -> service.move(original, parent, 2));
+        var saved = service.save(childMoved, original.path(), original.diskHash());
+        assertEquals(childMoved.text(), service.open(saved.path()).text());
+    }
