# Remove only our launcher; absent desktop-menu directories are valid on servers.
set -eu
case "$1" in
    remove|upgrade|deconfigure)
        rm -f /usr/share/applications/oscar-ui-OSCAR-UI.desktop
        ;;
    failed-upgrade)
        ;;
    *)
        echo "Unsupported prerm operation: $1" >&2
        exit 1
        ;;
esac
